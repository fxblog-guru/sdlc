# ops/config/staging.env.example — the variables the staging environment sets (DEV-PROFILE §Environments).
# Names and shapes only: a real value lives in the secret store, never in git (DEV-CONTRACTS §12.5).
APP_ENV=staging
LOG_LEVEL=info
HTTP_ADDR=:8080
DATABASE_URL=postgres://app@db.staging.invalid:5432/app?sslmode=require
# Telemetry (DEV-CONTRACTS §13.5): the service speaks OTLP to the collector; the collector, not the
# code, holds the backend. OBS_BACKENDS names the ops/otel/backends/*.yaml overlays this env loads.
OTEL_SERVICE_NAME=app
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OBS_BACKENDS=grafana
