#!/bin/sh
# commit-msg — DEV-CONTRACTS §18.1. Enable once per clone:
#   git config core.hooksPath .sdlc/ci/git-hooks        (dev/ci/git-hooks on a dev/ root)
# CI runs the same script over the merge request's range, so skipping this hook only moves the
# failure to the pipeline. The SDLC root is this file's grandparent, whatever it is called (§2).
root=$(cd "$(dirname "$0")/../.." && pwd)
command -v node >/dev/null 2>&1 || { echo "commit-msg: node not found, commit-lint skipped (CI still runs it)" >&2; exit 0; }
exec node "$root/scripts/commit-lint.mjs" --root "$root" --message "$1"
