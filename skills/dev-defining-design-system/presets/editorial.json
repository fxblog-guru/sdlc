{
  "schema": 2,
  "id": "editorial",
  "name": "Editorial",
  "summary": "Reading-first. Serif headings over a humanist sans, ink-blue accent, wide measure, 2px corners, almost no shadow. For content, docs and marketing surfaces.",
  "best_for": [
    "marketing and landing pages",
    "documentation, knowledge bases, help centres",
    "report and long-form reading views"
  ],
  "avoid_for": [
    "app screens with dense controls — pair with clean-saas for the app instead"
  ],
  "shell": "topnav",
  "density": "spacious",
  "kit": {
    "react": {
      "name": "shadcn/ui (Radix) + @tailwindcss/typography",
      "notes": "prose styles bound to the text.* and color.* tokens"
    },
    "nextjs": {
      "name": "shadcn/ui (Radix) + @tailwindcss/typography + MDX",
      "notes": "static by default; pages are server components"
    }
  },
  "kit_base": "radix-themes",
  "font": {
    "sans": "\"Source Sans 3\", ui-sans-serif, system-ui, sans-serif",
    "display": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif",
    "mono": "\"Source Code Pro\", ui-monospace, Menlo, monospace"
  },
  "color": {
    "light": {
      "bg": "#fdfcfa",
      "surface": "#ffffff",
      "surface-2": "#f4f1ec",
      "border": "#e6e1d8",
      "border-strong": "#8a8378",
      "text": "#1a1a1a",
      "text-muted": "#5a554d",
      "primary": "#1f4e79",
      "primary-hover": "#163a5a",
      "primary-fg": "#ffffff",
      "success": "#2e7d32",
      "warning": "#a15c07",
      "danger": "#b3261e",
      "danger-fg": "#ffffff",
      "info": "#1f4e79",
      "focus": "#1f4e79"
    },
    "dark": {
      "bg": "#121110",
      "surface": "#1b1a18",
      "surface-2": "#262421",
      "border": "#2e2b27",
      "border-strong": "#857e74",
      "text": "#ece8e1",
      "text-muted": "#aaa396",
      "primary": "#8fb8de",
      "primary-hover": "#b3d0ea",
      "primary-fg": "#0d1f30",
      "success": "#81c784",
      "warning": "#f0b35a",
      "danger": "#f28b82",
      "danger-fg": "#2b0a07",
      "info": "#8fb8de",
      "focus": "#b3d0ea"
    }
  },
  "type": {
    "body": "md",
    "scale": {
      "xs": [
        13,
        1.5,
        "captions, footnotes"
      ],
      "sm": [
        15,
        1.6,
        "secondary text, nav"
      ],
      "md": [
        18,
        1.7,
        "body copy — 60–75 characters per line"
      ],
      "lg": [
        21,
        1.5,
        "lead paragraph"
      ],
      "xl": [
        26,
        1.3,
        "h2 (display font)"
      ],
      "2xl": [
        34,
        1.2,
        "h1 (display font)"
      ],
      "3xl": [
        48,
        1.1,
        "hero headline (display font)"
      ]
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "ratio": 1.25,
    "roles": {
      "display": {
        "size": 48,
        "line": 1.1,
        "weight": 700,
        "tracking": -0.02
      },
      "h1": {
        "size": 38,
        "line": 1.2,
        "weight": 600,
        "tracking": -0.015
      },
      "h2": {
        "size": 30,
        "line": 1.25,
        "weight": 600,
        "tracking": -0.01
      },
      "h3": {
        "size": 24,
        "line": 1.35,
        "weight": 600,
        "tracking": 0
      },
      "body": {
        "size": 18,
        "line": 1.5,
        "weight": 400,
        "tracking": 0
      },
      "small": {
        "size": 15,
        "line": 1.45,
        "weight": 400,
        "tracking": 0.005
      },
      "mono": {
        "size": 15,
        "line": 1.5,
        "weight": 400,
        "tracking": 0,
        "font": "mono"
      },
      "tabular": {
        "size": 18,
        "line": 1.5,
        "weight": 400,
        "tracking": 0,
        "numeric": "tabular-nums"
      }
    }
  },
  "space": [
    0,
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96,
    128
  ],
  "radius": {
    "none": 0,
    "sm": 2,
    "md": 2,
    "lg": 4,
    "xl": 8,
    "full": 9999
  },
  "elevation": {
    "light": {
      "0": "none",
      "1": "none",
      "2": "0 1px 3px rgb(26 26 26 / 0.08)",
      "3": "0 8px 24px rgb(26 26 26 / 0.10)"
    },
    "dark": {
      "0": "none",
      "1": "none",
      "2": "0 1px 3px rgb(0 0 0 / 0.5)",
      "3": "0 8px 24px rgb(0 0 0 / 0.6)"
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "400ms",
    "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)"
  },
  "breakpoints": {
    "sm": 360,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1536
  },
  "control": {
    "height-sm": 36,
    "height-md": 44,
    "height-lg": 52,
    "row-height": 52,
    "target-min": 24,
    "sidebar-width": 260,
    "content-max": 720
  },
  "neutral": {
    "50": "#fafaf9",
    "100": "#f5f5f4",
    "200": "#e7e5e4",
    "300": "#d6d3d1",
    "400": "#a8a29e",
    "500": "#78716c",
    "600": "#57534e",
    "700": "#44403c",
    "800": "#292524",
    "900": "#1c1917",
    "950": "#0c0a09"
  },
  "dataviz": {
    "light": [
      "#2a78d6",
      "#eb6834",
      "#1baf7a",
      "#eda100",
      "#e87ba4",
      "#008300",
      "#6250d6",
      "#e34948"
    ],
    "dark": [
      "#3987e5",
      "#d95926",
      "#199e70",
      "#c98500",
      "#d55181",
      "#008300",
      "#9085e9",
      "#e66767"
    ]
  },
  "icon": {
    "set": "lucide",
    "stroke": 1.5,
    "sizes": {
      "sm": 16,
      "md": 18,
      "lg": 24
    }
  },
  "density_modes": {
    "spacious": {
      "row-height": 52,
      "control-height": 44,
      "cell-pad-x": 20,
      "cell-pad-y": 16
    },
    "comfortable": {
      "row-height": 44,
      "control-height": 40,
      "cell-pad-x": 16,
      "cell-pad-y": 12
    }
  },
  "extra_roles": {
    "tint-success": {
      "light": "#e6efe6",
      "dark": "#2d392b",
      "use": "success badge, notice and row fill"
    },
    "tint-warning": {
      "light": "#f4ebe1",
      "dark": "#413624",
      "use": "warning badge, notice and row fill"
    },
    "tint-danger": {
      "light": "#f6e5e4",
      "dark": "#422e2b",
      "use": "danger badge, notice and row fill"
    },
    "tint-info": {
      "light": "#e4eaef",
      "dark": "#30363c",
      "use": "info badge, notice and row fill"
    }
  },
  "extra_contrast_pairs": [
    {
      "fg": "text",
      "bg": "tint-success",
      "kind": "text"
    },
    {
      "fg": "success",
      "bg": "tint-success",
      "kind": "non-text"
    },
    {
      "fg": "text",
      "bg": "tint-warning",
      "kind": "text"
    },
    {
      "fg": "warning",
      "bg": "tint-warning",
      "kind": "non-text"
    },
    {
      "fg": "text",
      "bg": "tint-danger",
      "kind": "text"
    },
    {
      "fg": "danger",
      "bg": "tint-danger",
      "kind": "non-text"
    },
    {
      "fg": "text",
      "bg": "tint-info",
      "kind": "text"
    },
    {
      "fg": "info",
      "bg": "tint-info",
      "kind": "non-text"
    }
  ],
  "scrim": {
    "light": "rgba(9, 9, 11, 0.45)",
    "dark": "rgba(0, 0, 0, 0.6)"
  }
}
