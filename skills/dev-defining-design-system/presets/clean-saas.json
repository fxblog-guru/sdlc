{
  "schema": 2,
  "id": "clean-saas",
  "name": "Clean SaaS",
  "summary": "Neutral, quiet, content-first. Zinc greys, one indigo accent, generous whitespace, 8px corners. The look of Linear / Vercel-style tools.",
  "best_for": [
    "B2B SaaS and internal tools with moderate data density",
    "products that need to look modern without a brand team",
    "the default when nobody has a strong opinion"
  ],
  "avoid_for": [
    "screens that show 50+ rows at once — pick dense-enterprise",
    "consumer apps that need warmth — pick friendly-consumer"
  ],
  "shell": "sidebar",
  "density": "comfortable",
  "kit": {
    "react": {
      "name": "shadcn/ui (Radix primitives + Tailwind)",
      "notes": "copy-in components; theme via the CSS variables in tokens.css"
    },
    "nextjs": {
      "name": "shadcn/ui (Radix primitives + Tailwind)",
      "notes": "server components by default; Radix parts are client islands"
    }
  },
  "kit_base": "shadcn-new-york",
  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "color": {
    "light": {
      "bg": "#ffffff",
      "surface": "#ffffff",
      "surface-2": "#f4f4f5",
      "border": "#e4e4e7",
      "border-strong": "#8e8e96",
      "text": "#18181b",
      "text-muted": "#5f5f68",
      "primary": "#4f46e5",
      "primary-hover": "#4338ca",
      "primary-fg": "#ffffff",
      "success": "#15803d",
      "warning": "#a16207",
      "danger": "#dc2626",
      "danger-fg": "#ffffff",
      "info": "#2563eb",
      "focus": "#6366f1"
    },
    "dark": {
      "bg": "#09090b",
      "surface": "#18181b",
      "surface-2": "#27272a",
      "border": "#27272a",
      "border-strong": "#71717a",
      "text": "#fafafa",
      "text-muted": "#a1a1aa",
      "primary": "#818cf8",
      "primary-hover": "#a5b4fc",
      "primary-fg": "#1e1b4b",
      "success": "#4ade80",
      "warning": "#fbbf24",
      "danger": "#f87171",
      "danger-fg": "#450a0a",
      "info": "#60a5fa",
      "focus": "#a5b4fc"
    }
  },
  "type": {
    "body": "sm",
    "scale": {
      "xs": [
        12,
        1.5,
        "badges, meta"
      ],
      "sm": [
        14,
        1.5,
        "body, table cells, inputs"
      ],
      "md": [
        16,
        1.5,
        "lead text, card titles"
      ],
      "lg": [
        18,
        1.4,
        "section headings (h3)"
      ],
      "xl": [
        20,
        1.35,
        "panel headings (h2)"
      ],
      "2xl": [
        24,
        1.3,
        "page title (h1)"
      ],
      "3xl": [
        30,
        1.2,
        "dashboard hero numbers"
      ]
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "ratio": 1.25,
    "roles": {
      "display": {
        "size": 36,
        "line": 1.1,
        "weight": 700,
        "tracking": -0.02
      },
      "h1": {
        "size": 28,
        "line": 1.2,
        "weight": 600,
        "tracking": -0.015
      },
      "h2": {
        "size": 22,
        "line": 1.25,
        "weight": 600,
        "tracking": -0.01
      },
      "h3": {
        "size": 18,
        "line": 1.35,
        "weight": 600,
        "tracking": 0
      },
      "body": {
        "size": 14,
        "line": 1.5,
        "weight": 400,
        "tracking": 0
      },
      "small": {
        "size": 12,
        "line": 1.45,
        "weight": 400,
        "tracking": 0.005
      },
      "mono": {
        "size": 13,
        "line": 1.5,
        "weight": 400,
        "tracking": 0,
        "font": "mono"
      },
      "tabular": {
        "size": 14,
        "line": 1.5,
        "weight": 400,
        "tracking": 0,
        "numeric": "tabular-nums"
      }
    }
  },
  "space": [
    0,
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 12,
    "full": 9999
  },
  "elevation": {
    "light": {
      "0": "none",
      "1": "0 1px 2px rgb(0 0 0 / 0.05)",
      "2": "0 4px 12px rgb(0 0 0 / 0.08)",
      "3": "0 12px 32px rgb(0 0 0 / 0.12)"
    },
    "dark": {
      "0": "none",
      "1": "0 1px 2px rgb(0 0 0 / 0.4)",
      "2": "0 4px 12px rgb(0 0 0 / 0.5)",
      "3": "0 12px 32px rgb(0 0 0 / 0.6)"
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "280ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "breakpoints": {
    "sm": 360,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1536
  },
  "control": {
    "height-sm": 32,
    "height-md": 36,
    "height-lg": 44,
    "row-height": 44,
    "target-min": 24,
    "sidebar-width": 240,
    "content-max": 1200
  },
  "neutral": {
    "50": "#fafafa",
    "100": "#f4f4f5",
    "200": "#e4e4e7",
    "300": "#d4d4d8",
    "400": "#a1a1aa",
    "500": "#71717a",
    "600": "#52525b",
    "700": "#3f3f46",
    "800": "#27272a",
    "900": "#18181b",
    "950": "#09090b"
  },
  "dataviz": {
    "light": [
      "#2a78d6",
      "#eb6834",
      "#1baf7a",
      "#eda100",
      "#e87ba4",
      "#008300",
      "#6250d6",
      "#e34948"
    ],
    "dark": [
      "#3987e5",
      "#d95926",
      "#199e70",
      "#c98500",
      "#d55181",
      "#008300",
      "#9085e9",
      "#e66767"
    ]
  },
  "icon": {
    "set": "lucide",
    "stroke": 1.75,
    "sizes": {
      "sm": 14,
      "md": 16,
      "lg": 20
    }
  },
  "density_modes": {
    "comfortable": {
      "row-height": 44,
      "control-height": 36,
      "cell-pad-x": 16,
      "cell-pad-y": 12
    },
    "compact": {
      "row-height": 36,
      "control-height": 32,
      "cell-pad-x": 12,
      "cell-pad-y": 8
    }
  },
  "extra_roles": {
    "tint-success": {
      "light": "#e3f0e8",
      "dark": "#213c2d",
      "use": "success badge, notice and row fill"
    },
    "tint-warning": {
      "light": "#f4ece1",
      "dark": "#41361d",
      "use": "warning badge, notice and row fill"
    },
    "tint-danger": {
      "light": "#fbe5e5",
      "dark": "#40282a",
      "use": "danger badge, notice and row fill"
    },
    "tint-info": {
      "light": "#e5ecfd",
      "dark": "#253143",
      "use": "info badge, notice and row fill"
    }
  },
  "extra_contrast_pairs": [
    {
      "fg": "text",
      "bg": "tint-success",
      "kind": "text"
    },
    {
      "fg": "success",
      "bg": "tint-success",
      "kind": "non-text"
    },
    {
      "fg": "text",
      "bg": "tint-warning",
      "kind": "text"
    },
    {
      "fg": "warning",
      "bg": "tint-warning",
      "kind": "non-text"
    },
    {
      "fg": "text",
      "bg": "tint-danger",
      "kind": "text"
    },
    {
      "fg": "danger",
      "bg": "tint-danger",
      "kind": "non-text"
    },
    {
      "fg": "text",
      "bg": "tint-info",
      "kind": "text"
    },
    {
      "fg": "info",
      "bg": "tint-info",
      "kind": "non-text"
    }
  ],
  "scrim": {
    "light": "rgba(9, 9, 11, 0.45)",
    "dark": "rgba(0, 0, 0, 0.6)"
  }
}
