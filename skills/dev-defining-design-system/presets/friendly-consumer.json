      "2": "0 6px 16px rgb(0 0 0 / 0.5)",
      "3": "0 16px 40px rgb(0 0 0 / 0.6)"
    }
  },
  "motion": {
    "fast": "150ms",
    "base": "220ms",
    "slow": "350ms",
    "easing": "cubic-bezier(0.3, 0, 0, 1)"
