{
  "schema": 2,
  "id": "friendly-consumer",
  "name": "Friendly Consumer",
  "summary": "Warm and approachable. Stone neutrals, violet accent, 16px body, 12px corners, soft shadows, bigger targets. For people who did not choose to learn your product.",
  "best_for": [
    "consumer and SMB self-serve products",
    "onboarding-heavy flows, booking, customer portals",
    "audiences with mixed digital confidence"
  ],
  "avoid_for": [
    "dense tabular work — pick dense-enterprise",
    "regulated or finance products that must feel sober — pick clean-saas"
  ],
  "shell": "topnav",
  "density": "spacious",
  "kit": {
    "react": {
      "name": "shadcn/ui (Radix primitives + Tailwind)",
      "notes": "copy-in components; theme via the CSS variables in tokens.css"
    },
    "nextjs": {
      "name": "shadcn/ui (Radix primitives + Tailwind)",
      "notes": "server components by default; Radix parts are client islands"
    }
  },
  "kit_base": "shadcn-new-york",
  "font": {
    "sans": "\"Plus Jakarta Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "color": {
    "light": {
      "bg": "#fafaf9",
      "surface": "#ffffff",
      "surface-2": "#f5f5f4",
      "border": "#e7e5e4",
      "border-strong": "#8f8a86",
      "text": "#1c1917",
      "text-muted": "#5c5652",
      "primary": "#7c3aed",
      "primary-hover": "#6d28d9",
      "primary-fg": "#ffffff",
      "success": "#16a34a",
      "warning": "#d97706",
      "danger": "#dc2626",
      "danger-fg": "#ffffff",
      "info": "#0284c7",
      "focus": "#8b5cf6"
    },
    "dark": {
      "bg": "#141210",
      "surface": "#1f1c1a",
      "surface-2": "#2a2624",
      "border": "#2f2a27",
      "border-strong": "#78716c",
      "text": "#f5f5f4",
      "text-muted": "#aaa29d",
      "primary": "#a78bfa",
      "primary-hover": "#c4b5fd",
      "primary-fg": "#1e1236",
      "success": "#4ade80",
      "warning": "#fbbf24",
      "danger": "#f87171",
      "danger-fg": "#2a0808",
      "info": "#38bdf8",
      "focus": "#c4b5fd"
    }
  },
  "type": {
    "body": "md",
    "scale": {
      "xs": [
        13,
        1.5,
        "meta, captions"
      ],
      "sm": [
        14,
        1.5,
        "secondary text, helper text"
      ],
      "md": [
        16,
        1.6,
        "body, inputs"
      ],
      "lg": [
        18,
        1.5,
        "lead text, card titles"
      ],
      "xl": [
        22,
        1.35,
        "section headings (h2)"
      ],
      "2xl": [
        28,
        1.25,
        "page title (h1)"
      ],
      "3xl": [
        36,
        1.15,
        "hero / welcome"
      ]
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "ratio": 1.25,
    "roles": {
      "display": {
        "size": 40,
        "line": 1.1,
        "weight": 700,
        "tracking": -0.02
      },
      "h1": {
        "size": 32,
        "line": 1.2,
        "weight": 600,
        "tracking": -0.015
      },
      "h2": {
        "size": 26,
        "line": 1.25,
        "weight": 600,
        "tracking": -0.01
      },
      "h3": {
        "size": 20,
        "line": 1.35,
        "weight": 600,
        "tracking": 0
      },
      "body": {
        "size": 16,
        "line": 1.5,
        "weight": 400,
        "tracking": 0
      },
      "small": {
        "size": 13,
        "line": 1.45,
        "weight": 400,
        "tracking": 0.005
      },
      "mono": {
        "size": 14,
        "line": 1.5,
        "weight": 400,
        "tracking": 0,
        "font": "mono"
      },
      "tabular": {
        "size": 16,
        "line": 1.5,
        "weight": 400,
        "tracking": 0,
        "numeric": "tabular-nums"
      }
    }
  },
  "space": [
    0,
    4,
    8,
    12,
    16,
    24,
    32,
    40,
    48,
    64,
    80
