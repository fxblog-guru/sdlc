{
  "name": "vscode-sdlc",
  "displayName": "Agentic SDLC",
  "description": "Live board for the agentic-fx-dev pipeline: gate progress, tasks, findings and activity, from dev/state.json and the files it is built from.",
  "version": "0.5.3",
  "publisher": "agentic-fx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/agentic-fx/sdlc.git",
    "directory": "editor/vscode-sdlc"
  },
  "homepage": "https://gitlab.com/agentic-fx/sdlc/-/tree/main/editor/vscode-sdlc",
  "bugs": {
    "url": "https://gitlab.com/agentic-fx/sdlc/-/issues"
  },
  "icon": "media/icon.png",
  "keywords": [
    "sdlc",
    "agentic",
    "claude",
    "gates",
    "kanban"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/dev/state.json",
    "workspaceContains:**/.sdlc/state.json",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sdlc",
          "title": "Agentic SDLC",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sdlc": [
        {
          "type": "webview",
          "id": "sdlc.overview",
          "name": "Overview"
        }
      ]
    },
    "commands": [
      {
        "command": "sdlc.openBoard",
        "title": "SDLC: Open Board",
        "icon": "$(project)"
      },
      {
        "command": "sdlc.refresh",
        "title": "SDLC: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sdlc.selectProject",
        "title": "SDLC: Select Project",
        "icon": "$(folder-library)"
      },
      {
        "command": "sdlc.updateOptions",
        "title": "SDLC: Bundle Update Options",
        "icon": "$(arrow-up)"
      },
      {
        "command": "sdlc.openAgents",
        "title": "SDLC: Open Agents",
        "icon": "$(organization)"
      },
      {
        "command": "sdlc.openArtifact",
        "title": "SDLC: Open Artifact"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sdlc.selectProject",
          "when": "view == sdlc.overview && sdlc.multiProject",
          "group": "navigation@0"
        },
        {
          "command": "sdlc.openBoard",
          "when": "view == sdlc.overview",
          "group": "navigation@1"
        },
        {
          "command": "sdlc.refresh",
          "when": "view == sdlc.overview",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Agentic SDLC",
      "properties": {
        "sdlc.statePath": {
          "type": "string",
          "default": "",
          "description": "Path to the derived state index, relative to the workspace folder. Empty (default): .sdlc/state.json when the project has a .sdlc/ root, else dev/state.json — the bundle's own order (DEV-CONTRACTS §2). Set it only when DEV-PROFILE `SDLC root` names another folder."
        },
        "sdlc.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the active initiative, its gate and its open-finding count in the status bar."
        },
        "sdlc.accent": {
          "type": "string",
          "enum": [
            "lavender",
            "purple",
            "theme"
          ],
          "enumDescriptions": [
            "Soft lavender accent (default): gentle tints for focus, selection and progress, deeper shades only for text.",
            "A more saturated violet accent.",
            "Follow the editor theme accent (focus border and buttons)."
          ],
          "default": "lavender",
          "description": "Accent colour of the board, the sidebar Overview and the status bar item."
        },
        "sdlc.backgroundRebuild": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run the project's `node dev/scripts/build-state.mjs` in the background when a progress row, gate log, lane note, verification run or the ledger changes. Off by default: it rewrites `state.json` and `DASHBOARD.md`, as the Stop hook does. Without it the board still updates live by reading those files directly."
        },
        "sdlc.backgroundRebuildSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 15,
          "description": "Minimum seconds between two background rebuilds."
        }
      }
    },
    "colors": [
      {
        "id": "sdlc.accentForeground",
        "description": "Accent text of the SDLC status bar item.",
        "defaults": {
          "dark": "#c4b5fd",
          "light": "#6d4fc4",
          "highContrast": "#d7ccff",
          "highContrastLight": "#4c2fa8"
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test out/test/*.test.js",
    "test:integration": "tsc -p ./ && node out/test/integration/run.js",
    "test:all": "npm test && npm run test:integration"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "typescript": "^5.5.0"
  }
}
